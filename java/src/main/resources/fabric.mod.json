{
  "schemaVersion": 1,
  "id": "skycraft",
  "version": "${version}",
  "name": "UltraCraft Java Companion",
  "description": "Minecraft survival simulation for UltraCraft's ULTRAKILL bridge.",
  "authors": ["Qua5eyeNimbl3", "chasmlol", "aeironnsarmiento"],
  "contact": {
    "sources": "https://github.com/Qua5eyeNimbl3/UltraCraft"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": ["dev.skycraft.SkyCraft"],
    "client": ["dev.skycraft.client.SkyCraftClient"]
  },
  "mixins": [
    "skycraft.mixins.json",
    { "config": "skycraft.client.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
